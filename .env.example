# Server-only pooled connection for application runtime. Never prefix with NEXT_PUBLIC_.
CONSENSUS_DATABASE_URL=

# Server-only direct connection for explicitly authorized migration commands.
CONSENSUS_MIGRATION_DATABASE_URL=

# Disposable PostgreSQL only; used by the opt-in persistence integration suite.
CONSENSUS_TEST_DATABASE_URL=

# Destructive rehearsal guard. Enable only for a localhost database whose name
# contains "test"; the rehearsal creates and removes a disposable restore copy.
CONSENSUS_RECOVERY_REHEARSAL=false

# 32 random bytes encoded as 43 base64url characters. Server-only and distinct
# per environment. Its absence makes private room routes fail closed with 503.
CONSENSUS_CAPABILITY_PEPPER=

# Emergency create-room circuit breaker. Omit or set true for the default; set
# false to stop anonymous room creation while preserving existing room reads.
CONSENSUS_ROOM_CREATION_ENABLED=true

# Emergency admission circuit breaker; set false to reject new join requests
# without interrupting already-authorized room participants.
CONSENSUS_ROOM_JOIN_ENABLED=true

# Optional emergency switch for host-authorized, short-lived browser transfer.
CONSENSUS_HOST_RECOVERY_ENABLED=true

# Retention deletion is disabled unless explicitly enabled for one bounded run.
# The worker emits counts only and never room identifiers or stored payloads.
CONSENSUS_RETENTION_DELETE_ENABLED=false
CONSENSUS_RETENTION_DELETE_LIMIT=100
